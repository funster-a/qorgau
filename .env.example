# --- LLM (Groq, OpenAI-совместимый) ---
GROQ_API_KEY=gsk_xxx_вставь_свой_ключ
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Проверь актуальное имя модели в консоли Groq (console.groq.com).
GROQ_MODEL=llama-3.3-70b-versatile

# --- База данных ---
# Порт 55432: 5432/5433 на хосте обычно заняты локально установленным PostgreSQL.
DATABASE_URL=postgres://qorgau:qorgau@localhost:55432/qorgau?sslmode=disable

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:вставь_токен_от_BotFather

# --- API ---
API_ADDR=:8080
PII_TTL_HOURS=24
# Ключ шифрования зоны PII (pgcrypto). В демо можно оставить дефолт, в проде — обязательно свой.
PII_ENC_KEY=qorgau-demo-key

# --- Защита служебных эндпоинтов (пусто = открыто, для локального демо ок) ---
# ADMIN_TOKEN=придумай_строку   # закрывает /admin/* (пульт демо шлёт X-Admin-Token)
# BOT_API_KEY=придумай_строку   # общий секрет api<->bot для /bot/*

# --- Бот ---
API_URL=http://localhost:8080

# --- Переопределение путей (нужно только в Docker, локально не трогать) ---
# ENGINE_PROMPT_PATH=engine/prompt.md
# SCHEMA_PATH=db/schema.sql
# WEB_DIR=web
