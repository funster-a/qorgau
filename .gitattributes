# В репозитории всё хранится с LF.
* text=auto eol=lf

# Эти файлы монтируются внутрь Linux-контейнеров (Postgres init, provisioning
# Grafana) — им нужен LF в рабочей копии даже на Windows.
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Бинарники не трогать.
*.png binary
*.jpg binary
*.apk binary
